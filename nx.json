{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "test:cov": {
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "cache": true
    },
    "format": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "test": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test:watch": {
      "cache": true
    },
    "test:debug": {
      "cache": true
    },
    "test:e2e": {
      "cache": true,
      "inputs": [
        "default"
      ]
    }
  },
  "defaultBase": "master",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    }
  ]
}