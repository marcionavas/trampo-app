###########################################
# .gitignore - staging/produção
# Para builds de STAGING/PRODUÇÃO:
#   - Mantenha as linhas abaixo descomentadas para ignorar pastas de teste/configs de teste.
# Para builds de CI/teste:
#   - Comente as linhas abaixo para permitir versionamento e execução de testes.
###########################################
# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build
dist/
coverage/

# Env
.env
.env.local
.env.*.local
.env.test
apps/*/.env.*
libs/*/.env.*

# IDE/OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml
docker-compose.*.override.yml
.docker/
**/.docker/

# Monorepo - ignorar artefatos dos apps/libs
apps/*/node_modules/
apps/*/dist/
apps/*/coverage/
libs/*/node_modules/
libs/*/dist/
libs/*/coverage/

# Test
test/
apps/*/test/
libs/*/test/
apps/*/jest-*.json
libs/*/jest-*.json
jest-*.json
*.lcov
*.lcov.info

# Prisma
prisma/.env
prisma/migrations/
apps/*/prisma/.env
apps/*/prisma/migrations/
apps/*/prisma/migration_lock.toml

# Logs
logs/
*.log
*.out
*.err

# Cache
.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
.cache/
tmp/
temp/
*.tmp
*.bak

# Backup files
*.bak
*.old
*.orig
*.save

# OS generated files
ehthumbs.db
Icon?
Desktop.ini

# Others
*.pid
*.seed
*.sqlite
*.sqlite3
*.db
*.tgz