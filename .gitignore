#
# Para builds de PRODUÇÃO: se quiser ignorar arquivos de teste, descomente as linhas abaixo.
#   test
#   apps/*/test
#   libs/*/test
# Isso evita que testes sejam enviados para produção, mas lembre-se de manter essas linhas comentadas para CI/CD.
# ===============================
# .gitignore - Padrão profissional
#
# Para builds de PRODUÇÃO e CI:
#   - Este arquivo já está adequado para pipelines, ignorando node_modules, dist, coverage, envs, logs, arquivos temporários e de backup.
#   - Pastas de teste NÃO são ignoradas, permitindo versionamento e execução de testes em CI.
#   - Se quiser ignorar arquivos de teste em produção, ajuste conforme a política do time.
# ===============================
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
coverage/

.env
.env.local
.env.*.local
.env.test
apps/*/.env.*
libs/*/.env.*

.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

docker-compose.override.yml
docker-compose.*.override.yml
.docker/
**/.docker/

apps/*/node_modules/
apps/*/dist/
apps/*/coverage/
libs/*/node_modules/
libs/*/dist/
libs/*/coverage/

# Testes não ignorados para versionamento e CI/CD
# apps/*/jest-*.json
# libs/*/jest-*.json
# jest-*.json
# *.lcov
# *.lcov.info

prisma/.env
prisma/migrations/
apps/*/prisma/.env
apps/*/prisma/migrations/
apps/*/prisma/migration_lock.toml

logs/
*.log
*.out
*.err

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
.cache/
tmp/
temp/
*.tmp
*.bak

*.bak
*.old
*.orig
*.save

ehthumbs.db
Icon?
Desktop.ini

*.pid
*.seed
*.sqlite
*.sqlite3
*.db
*.tgz