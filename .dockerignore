# ===============================
# .dockerignore - Padrão profissional
#
# Para builds de PRODUÇÃO:
#   - Mantenha as linhas abaixo descomentadas para ignorar pastas de teste e configs de teste.
# Para builds de TESTE/CI:
#   - Comente as linhas abaixo para permitir a cópia das pastas de teste para o container.
#
# Dica: Ajuste antes do build conforme o ambiente!
# ===============================
node_modules
dist
coverage
.env
.env.*
*.log
*.out
*.err
*.tmp
*.bak
*.old
*.orig
*.save
.git
.gitignore
docker-compose.yml
docker-compose.*.yml
.vscode
.idea
.DS_Store
Thumbs.db
# ====== Ignorar testes e configs de teste (PRODUÇÃO) ======
#test              # <--- Comente para builds de CI/teste
#apps/*/test       # <--- Comente para builds de CI/teste
#libs/*/test       # <--- Comente para builds de CI/teste
# =========================================================
apps/*/node_modules
apps/*/dist
apps/*/coverage
apps/*/.env*
apps/*/prisma/.env
apps/*/prisma/migrations
apps/*/prisma/migration_lock.toml
libs/*/node_modules
libs/*/dist
libs/*/coverage
libs/*/.env*
prisma/.env
prisma/migrations
prisma/migration_lock.toml