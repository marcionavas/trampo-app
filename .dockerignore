###########################################
# .dockerignore - staging/produção
# Para builds de STAGING/PRODUÇÃO:
#   - Mantenha as linhas abaixo descomentadas para ignorar pastas de teste/configs de teste.
# Para builds de CI/teste:
#   - Comente as linhas abaixo para permitir testes no container.
###########################################
node_modules
# Ignore build output
# dist/ REMOVIDO para permitir build dos containers de staging
coverage
.env
.env.*
*.log
*.out
*.err
*.tmp
*.bak
*.old
*.orig
*.save
.git
.gitignore
docker-compose.yml
docker-compose.*.yml
.vscode
.idea
.DS_Store
Thumbs.db
test              # <--- Comente para builds de CI/teste
apps/*/test       # <--- Comente para builds de CI/teste
libs/*/test       # <--- Comente para builds de CI/teste
apps/*/node_modules
apps/*/dist
apps/*/coverage
apps/*/.env*
apps/*/prisma/.env
apps/*/prisma/migrations
apps/*/prisma/migration_lock.toml
libs/*/node_modules
libs/*/dist
libs/*/coverage
libs/*/.env*
prisma/.env
prisma/migrations
prisma/migration_lock.toml